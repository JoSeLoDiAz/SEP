{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      { "include": "**/*.png", "outDir": "dist", "watchAssets": true },
      { "include": "**/*.jpg", "outDir": "dist", "watchAssets": true },
      { "include": "**/*.ttf", "outDir": "dist", "watchAssets": true }
    ],
    "watchAssets": true
  }
}
